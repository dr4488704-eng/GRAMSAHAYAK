# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Supabase Credentials (PostgreSQL data platform)
# Optional in Demo Mode: GramSahay AI runs in full demo mode if not provided
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP Email Settings (Optional - GramSahay automatically falls back to Demo Email Mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GramSahay AI <notifications@gramsahay.gov.in.demo>"

# Environment & Demo Flag
NODE_ENV=development
DEMO_MODE=true

